[Unit]
Description=Daily fantasy_insights rebuild and publish

[Timer]
# Early enough that the site is current before anyone looks at it, late enough
# that the previous day's data has settled.
OnCalendar=*-*-* 05:30:00
# A missed day still runs at next boot — the site going stale is the failure
# mode worth avoiding.
Persistent=true
RandomizedDelaySec=900

[Install]
WantedBy=timers.target
