[Unit]
Description=Live refresh and publish: WNBA games, fantasy draft and weeks
After=network-online.target
Wants=network-online.target
OnFailure=notify@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/apps/gord-stats
EnvironmentFile=%h/secrets/gord-stats.env
ExecStart=%h/apps/gord-stats/deploy/pi-live.sh
# An ESPN check and a Sleeper check when idle; a fantasy fetch or a power-page
# rebuild, a Jekyll build and a wrangler upload when something fired — all
# comfortably inside 15 minutes on the Pi.
TimeoutStartSec=900
Environment=MPLBACKEND=Agg

[Install]
WantedBy=default.target
