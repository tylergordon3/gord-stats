[Unit]
Description=Daily cbb-model refresh and publish

[Timer]
# After the fantasy rebuild at 05:30 so the two aren't competing for the Pi's
# four cores, and late enough that the previous night's WNBA games have settled.
OnCalendar=*-*-* 06:30:00
Persistent=true
RandomizedDelaySec=900

[Install]
WantedBy=timers.target
