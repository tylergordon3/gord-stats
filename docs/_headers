# Response headers for every page, read by Cloudflare Pages at deploy time
# (Jekyll copies this file through: it is in _config.yml's `include`).
#
# HSTS: the site is HTTPS-only already; this tells browsers never to try
# otherwise. No includeSubDomains - nothing says every future subdomain will be.
# Framing: no page of this site is ever meant to sit inside another site's
# frame (added after the 2026-09-28 audit).
/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  X-Content-Type-Options: nosniff

# Content-hashed copies of the site's CSS and JS (docs/_plugins/fingerprint.rb,
# used by _layouts/default.html): the URL changes whenever the file does, so a
# browser may keep each one for a year without asking again. Only this path -
# the plain /assets/css/ and /assets/js/ names are still loaded unversioned
# (live.js on /men/, the CBB pages' toggles) and must keep revalidating, or a
# reader would hold a stale script for a year. They were all versioned by
# build time, which ~80 Saturday publishes turned into no caching at all.
/assets/v/*
  Cache-Control: public, max-age=31536000, immutable
